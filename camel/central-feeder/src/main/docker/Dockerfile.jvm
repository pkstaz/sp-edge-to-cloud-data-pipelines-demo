####
# JVM image for central-feeder. Requires rsync + find (Camel exec routes).
#
# We use Eclipse Temurin on Alpine instead of UBI + microdnf: unauthenticated
# `microdnf install` often hits HTTP 403 on cdn.redhat.com (no RHSM / network policy).
# For a fully RHEL-based image, build on a subscribed host or use registry.redhat.io with auth.
#
# Before build:
#   ./mvnw -DskipTests package
#   source ../../deployment/sp-demo-images.env.sh
#   podman build -f src/main/docker/Dockerfile.jvm -t "${SP_IMAGE_CENTRAL_FEEDER_JVM}" .
#
####
FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache rsync findutils

ENV LANG=C.UTF-8
# AWS SDK 2.30+ default checksum behaviour breaks MinIO PutObject
ENV AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED

# OpenShift-friendly UID/GID (same convention as UBI-based demo images)
RUN addgroup -g 185 -S quarkus && adduser -u 185 -S -G quarkus quarkus

WORKDIR /deployments

COPY --chown=185:185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185:185 target/quarkus-app/*.jar /deployments/
COPY --chown=185:185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185:185 target/quarkus-app/quarkus/ /deployments/quarkus/

RUN mkdir -p /deployments/unzipped /deployments/tempfiles \
    && chown -R quarkus:quarkus /deployments/unzipped /deployments/tempfiles

EXPOSE 8080
USER quarkus

ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
