####
# Modo JVM (rápido de compilar; más RAM en runtime). Antes:
#
#   ./mvnw -DskipTests package
#
#   source ../../deployment/sp-demo-images.env.sh
#   podman build -f src/main/docker/Dockerfile.jvm -t "${SP_IMAGE_EDGE_MANAGER_JVM}" .
#
####
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.20

ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en'
# AWS SDK 2.30+ calcula checksums en PutObject por defecto; MinIO devuelve 403 SignatureDoesNotMatch.
ENV AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
WORKDIR /deployments

COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185

ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
